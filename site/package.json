{
  "name": "hotdeal-hub-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "상테크 핫딜 허브 정적 사이트 (Tailwind CLI 빌드, D-08)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/assets/site.css --minify",
    "build:html": "node scripts/build.mjs",
    "build": "npm run build:html && npm run build:css",
    "dev": "npm run build:html -- --sample && tailwindcss -i ./src/styles/input.css -o ./dist/assets/site.css --watch",
    "preview": "npx serve dist",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@tailwindcss/typography": "^0.5.16"
  }
}
